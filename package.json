{
  "name": "enotaryhub-v2",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev --no-server-fast-refresh",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "cms:types": "payload generate:types",
    "cms:importmap": "payload generate:importmap",
