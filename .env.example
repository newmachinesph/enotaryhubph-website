# Canonical public URL used by metadata, robots.txt, and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://enotaryhub.ph

# Keep false for previews. Set true only when the site is ready for search.
NEXT_PUBLIC_SITE_INDEXABLE=false

# Optional token from Google Search Console's HTML-tag verification method.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Payload CMS and Postgres. Replace DATABASE_URL with a Neon connection string later.
DATABASE_URL=postgresql://enotaryhub:enotaryhub@localhost:5432/enotaryhub
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
